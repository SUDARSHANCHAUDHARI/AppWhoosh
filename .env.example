# ─── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ─── Android / Google Play ────────────────────────────────────
GOOGLE_PLAY_JSON_KEY_PATH=/Users/YOUR_MAC_USERNAME/.appwhoosh/credentials/play-key.json

# ─── iOS / App Store Connect ──────────────────────────────────
APP_STORE_KEY_ID=XXXXXXXXXX
APP_STORE_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_KEY_PATH=/Users/YOUR_MAC_USERNAME/.appwhoosh/credentials/AuthKey_XXXXXXXXXX.p8

# ─── fastlane Match (iOS code signing) ───────────────────────
MATCH_GIT_URL=git@github.com:YOUR_GITHUB_USERNAME/YOUR_CERTIFICATES_REPO.git
MATCH_PASSWORD=YOUR_MATCH_PASSWORD

# ─── Android Keystores ────────────────────────────────────────
KEYSTORE_BASE_PATH=/Users/YOUR_MAC_USERNAME/.appwhoosh/keystores
KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
KEYSTORE_KEY_PASSWORD=YOUR_KEYSTORE_KEY_PASSWORD

# ─── Build output ─────────────────────────────────────────────
BUILD_OUTPUT_DIR=/tmp/appwhoosh-builds

# ─── Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ─── Apple ────────────────────────────────────────────────────
APPLE_ID=YOUR_APPLE_ID
APPLE_TEAM_ID=XXXXXXXXXX
ITC_TEAM_ID=XXXXXXXXXX
