# ─── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Android / Google Play ────────────────────────────────────
GOOGLE_PLAY_JSON_KEY_PATH=/Users/yourname/.appwhoosh/credentials/play-key.json

# ─── iOS / App Store Connect ──────────────────────────────────
APP_STORE_KEY_ID=XXXXXXXXXX
APP_STORE_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_KEY_PATH=/Users/yourname/.appwhoosh/credentials/AuthKey_XXXXXXXXXX.p8

# ─── fastlane Match (iOS code signing) ───────────────────────
MATCH_GIT_URL=git@github.com:YOUR_USERNAME/your-certificates-repo.git
MATCH_PASSWORD=your_match_passphrase

# ─── Android Keystores ────────────────────────────────────────
KEYSTORE_BASE_PATH=/Users/yourname/.appwhoosh/keystores
KEYSTORE_PASSWORD=your_keystore_password
KEYSTORE_KEY_PASSWORD=your_key_password

# ─── Build output ─────────────────────────────────────────────
BUILD_OUTPUT_DIR=/tmp/appwhoosh-builds

# ─── Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Apple ────────────────────────────────────────────────────
APPLE_ID=your_apple_id@example.com
APPLE_TEAM_ID=XXXXXXXXXX
ITC_TEAM_ID=XXXXXXXXXX
